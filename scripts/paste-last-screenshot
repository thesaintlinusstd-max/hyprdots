#!/usr/bin/env bash
# Paste last screenshot to current directory (Thunar-friendly)
# Use Hyprland to detect Thunar window and get its working directory
# Falls back to current directory if Thunar not active

PID=$(hyprctl activewindow -j 2>/dev/null | jq -r '.pid' 2>/dev/null)
CLASS=$(hyprctl activewindow -j 2>/dev/null | jq -r '.class' 2>/dev/null)

if [[ "$CLASS" == "thunar" && -n "$PID" ]]; then
    DIR=$(for fd in /proc/$PID/fd/*; do
        readlink -f "$fd" 2>/dev/null
    done | while read -r p; do
        [ -d "$p" ] && echo "$p"
    done | head -n1)
fi

# Fallback to pwd if hyprctl/Thunar detection fails or fails
DIR=${DIR:-"$(pwd)"}

LAST=$(ls -t ~/Pictures/Screenshots/*.png 2>/dev/null | head -n1)

if [[ -n "$LAST" ]]; then
    cp "$LAST" "$DIR"/
    notify-send "کپی شد" "آخرین اسکرین‌شات -> $DIR"
    echo "✓ Last screenshot copied to $DIR"
else
    notify-send "خطا" "هیچ اسکرین‌شاتی در ~/Pictures/Screenshots یافت نشد"
    echo "✓ No screenshots found in ~/Pictures/Screenshots"
fi